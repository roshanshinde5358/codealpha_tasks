<!DOCTYPE html>
<html>
<head>
  <title>Product</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1><%= product.name %></h1>
  <img src="<%= product.image %>" width="250">
  <p><%= product.description %></p>
  <p>₹<%= product.price %></p>

  <a href="/add-to-cart/<%= product._id %>">Add To Cart</a>
</body>
</html>